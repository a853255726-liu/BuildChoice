{
  "description": "Prompt policy and observed decision replies; never blocks tasks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/buildchoice_plugin_hook.py\"",
            "timeout": 5,
            "statusMessage": "BuildChoice: UserPromptSubmit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$|^exec_command$|^functions\\.exec_command$|^mcp__filesystem__read_(file|text_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/buildchoice_plugin_hook.py\"",
            "timeout": 5,
            "statusMessage": "BuildChoice: observe project read"
          }
        ]
      }
    ]
  }
}
