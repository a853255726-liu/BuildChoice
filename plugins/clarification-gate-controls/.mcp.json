{
  "mcpServers": {
    "clarification_gate": {
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/scripts/launch.py"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
