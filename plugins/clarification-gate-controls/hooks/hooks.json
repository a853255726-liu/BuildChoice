{
  "description": "One receipt per supported workspace turn; results remain advisory.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/clarification_gate_plugin_hook.py\"",
            "timeout": 5,
            "statusMessage": "Clarification Gate: UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/clarification_gate_plugin_hook.py\"",
            "timeout": 5,
            "statusMessage": "Clarification Gate: PreToolUse"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/clarification_gate_plugin_hook.py\"",
            "timeout": 5,
            "statusMessage": "Clarification Gate: PostToolUse"
          }
        ],
        "matcher": "mcp__clarification_gate__(gate_evaluate|gate_assess_snapshot)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/clarification_gate_plugin_hook.py\"",
            "timeout": 5,
            "statusMessage": "Clarification Gate: Stop"
          }
        ]
      }
    ]
  }
}
