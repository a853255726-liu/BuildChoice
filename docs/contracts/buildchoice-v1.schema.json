{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:buildchoice:protocol:v1",
  "title": "BuildChoice v1 — advisory runtime contract",
  "$comment": "Root validates a response. Use #/$defs/Request or #/$defs/Assessment for those message types. Runtime checks must additionally verify provenance, coverage, revisions and backend capability.",
  "$ref": "#/$defs/Response",
  "$defs": {
    "Version": {"const": "buildchoice.v1"},
    "Identity": {"type": "string", "minLength": 1, "maxLength": 160},
    "Hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "FieldIds": {"type": "array", "uniqueItems": true, "maxItems": 64, "items": {"$ref": "#/$defs/Identity"}},
    "Context": {
      "type": "object", "additionalProperties": false,
      "required": ["host_session_id", "turn_id", "context_handle", "revision"],
      "properties": {
        "host_session_id": {"$ref": "#/$defs/Identity"},
        "desktop_thread_id": {"type": ["string", "null"], "maxLength": 160},
        "turn_id": {"$ref": "#/$defs/Identity"},
        "agent_id": {"type": ["string", "null"], "maxLength": 160},
        "context_handle": {"$ref": "#/$defs/Identity"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "BackendRef": {
      "type": "object", "additionalProperties": false,
      "required": ["backend_id", "artifact_version", "manifest_sha256", "input_projection_version", "calibration_version"],
      "properties": {
        "backend_id": {"$ref": "#/$defs/Identity"},
        "artifact_version": {"$ref": "#/$defs/Identity"},
        "manifest_sha256": {"$ref": "#/$defs/Hash"},
        "input_projection_version": {"$ref": "#/$defs/Identity"},
        "calibration_version": {"$ref": "#/$defs/Identity"}
      }
    },
    "FieldStates": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "resolved", "indexed"],
      "properties": {
        "required": {"$ref": "#/$defs/FieldIds"},
        "resolved": {"$ref": "#/$defs/FieldIds"},
        "indexed": {"$ref": "#/$defs/FieldIds"}
      }
    },
    "Snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "snapshot_sha256", "task", "messages", "evidence", "resources", "candidates", "candidate_coverage"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/Identity"},
        "snapshot_sha256": {"$ref": "#/$defs/Hash"},
        "task": {
          "type": "object", "additionalProperties": false, "required": ["text", "origin"],
          "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 16000}, "origin": {"const": "user_message"}}
        },
        "messages": {
          "type": "array", "maxItems": 80,
          "items": {"type": "object", "additionalProperties": false, "required": ["message_id", "role", "text", "origin"],
            "properties": {
              "message_id": {"$ref": "#/$defs/Identity"},
              "role": {"enum": ["user", "assistant", "tool"]},
              "text": {"type": "string", "maxLength": 16000},
              "origin": {"enum": ["user_message", "agent_statement", "tool_result", "quoted_document"]}
            }
          }
        },
        "evidence": {
          "type": "array", "maxItems": 40,
          "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "origin", "content", "content_sha256", "resource_id"],
            "properties": {
              "evidence_id": {"$ref": "#/$defs/Identity"},
              "origin": {"enum": ["supplied_context", "observed_tool_result", "quoted_document"]},
              "content": {"type": "string", "maxLength": 32000},
              "content_sha256": {"$ref": "#/$defs/Hash"},
              "resource_id": {"type": ["string", "null"], "maxLength": 160}
            }
          }
        },
        "resources": {
          "type": "array", "maxItems": 40,
          "items": {"type": "object", "additionalProperties": false, "required": ["resource_id", "locator", "read_state", "indexed_fields"],
            "properties": {
              "resource_id": {"$ref": "#/$defs/Identity"},
              "locator": {"type": "string", "minLength": 1, "maxLength": 1024},
              "read_state": {"enum": ["unread", "read", "read_failed"]},
              "indexed_fields": {"$ref": "#/$defs/FieldIds"}
            }
          }
        },
        "candidates": {
          "type": "array", "maxItems": 64,
          "items": {"type": "object", "additionalProperties": false, "required": ["field_id", "name", "origin"],
            "properties": {
              "field_id": {"$ref": "#/$defs/Identity"},
              "name": {"type": "string", "minLength": 1, "maxLength": 160},
              "origin": {"enum": ["user_explicit", "agent_inferred", "test_fixture", "reviewed_snapshot"]}
            }
          }
        },
        "candidate_coverage": {"enum": ["verified", "declared", "unknown"]}
      }
    },
    "Request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "context", "snapshot", "event"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/Version"},
        "request_id": {"$ref": "#/$defs/Identity"},
        "context": {"$ref": "#/$defs/Context"},
        "snapshot": {"$ref": "#/$defs/Snapshot"},
        "event": {"enum": ["user_prompt", "before_tool", "after_read", "manual_evaluate", "user_reply"]},
        "pending_tool": {"type": ["object", "null"], "additionalProperties": false, "required": ["name", "call_id", "effect"],
          "properties": {"name": {"$ref": "#/$defs/Identity"}, "call_id": {"$ref": "#/$defs/Identity"}, "effect": {"enum": ["read_only", "write", "external_side_effect", "unknown"]}}}
      }
    },
    "Assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "backend", "kind", "field_states", "action_advice", "score_semantics", "reason_codes"],
      "properties": {
        "status": {"enum": ["OK", "UNSUPPORTED", "NOT_READY", "ERROR"]},
        "backend": {"$ref": "#/$defs/BackendRef"},
        "kind": {"enum": ["field_states", "action_advice", "none"]},
        "field_states": {"anyOf": [{"$ref": "#/$defs/FieldStates"}, {"type": "null"}]},
        "action_advice": {"enum": ["PASS", "INSPECT", "ASK", null]},
        "score_semantics": {"enum": ["nli_margin_score", "model_specific", "none"]},
        "reason_codes": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/Identity"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "OK"}}}, "then": {"oneOf": [
          {"properties": {"kind": {"const": "field_states"}, "field_states": {"$ref": "#/$defs/FieldStates"}, "action_advice": {"type": "null"}}},
          {"properties": {"kind": {"const": "action_advice"}, "field_states": {"type": "null"}, "action_advice": {"enum": ["PASS", "INSPECT", "ASK"]}}}
        ]}, "else": {"properties": {"kind": {"const": "none"}, "field_states": {"type": "null"}, "action_advice": {"type": "null"}}}}
      ]
    },
    "Response": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "snapshot_id", "revision", "mode", "status", "action", "effect", "backend", "assessment", "next_step", "policy_version", "reason_codes", "task_executed"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/Version"},
        "request_id": {"$ref": "#/$defs/Identity"},
        "snapshot_id": {"$ref": "#/$defs/Identity"},
        "revision": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["shadow", "advisory", "enforce"]},
        "status": {"enum": ["OK", "UNSUPPORTED", "NOT_READY", "ERROR", "STALE"]},
        "action": {"enum": ["PASS", "INSPECT", "ASK", null]},
        "effect": {"enum": ["record_only", "suggest_only", "continue_native", "hold_covered_operation"]},
        "backend": {"$ref": "#/$defs/BackendRef"},
        "assessment": {"$ref": "#/$defs/Assessment"},
        "next_step": {
          "type": "object", "additionalProperties": false,
          "required": ["missing_fields", "inspect_resource_ids", "question_hint"],
          "properties": {
            "missing_fields": {"$ref": "#/$defs/FieldIds"},
            "inspect_resource_ids": {"$ref": "#/$defs/FieldIds"},
            "question_hint": {"type": ["string", "null"], "maxLength": 1000}
          }
        },
        "policy_version": {"$ref": "#/$defs/Identity"},
        "reason_codes": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/Identity"}},
        "task_executed": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "OK"}}}, "then": {"properties": {"action": {"enum": ["PASS", "INSPECT", "ASK"]}}}, "else": {"properties": {"action": {"type": "null"}}}},
        {"if": {"properties": {"mode": {"const": "shadow"}}}, "then": {"properties": {"effect": {"const": "record_only"}}}},
        {"if": {"properties": {"mode": {"const": "advisory"}}}, "then": {"properties": {"effect": {"enum": ["suggest_only", "continue_native"]}}}}
      ]
    }
  }
}
